# Demandes de devis (route /api/devis) : envoi par e-mail via SMTP, aucune base de données.
# Destinataire (atelier) et expéditeur (adresse autorisée par le serveur SMTP).
QUOTE_TO=atelier@example.com
QUOTE_FROM="JR Diamond <devis@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# 1 = TLS direct (port 465). Vide : déduit du port. Sinon, STARTTLS est imposé : l'envoi échoue plutôt que de partir en clair.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Adresse publique du site, pour le lien vers le modèle dans l'e-mail (sinon : origine de la requête).
SITE_URL=
# 1 = n'envoie rien, écrit l'e-mail dans le journal du serveur (développement, tests).
QUOTE_DRY_RUN=

# Numéro WhatsApp de l'atelier, format international (ex. 972501234567). Renseigné : le formulaire de devis
# propose « Envoyer sur WhatsApp » (lien wa.me, message pré-rempli). Variable publique, lue au build.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Coordonnées affichées au pied de chaque page (variables publiques, lues au build). Vides : rien n'est affiché.
# Le numéro WhatsApp ci-dessus ajoute aussi un lien « WhatsApp » au pied de page.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Adresse publique du site (origine, sans barre finale), base des adresses absolues : aperçus de liens partagés
# (og:url, og:image), plan du site, robots.txt. Vide : https://jr-diamond.vercel.app. À renseigner avec le domaine définitif
# au lancement. Variable publique, lue au build ; une valeur invalide fait échouer le build. Indépendante de SITE_URL
# ci-dessus (lien de l'e-mail de devis, lu à l'exécution).
NEXT_PUBLIC_SITE_URL=
